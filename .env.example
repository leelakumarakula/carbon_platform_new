# Copy to backend/.env and fill in. Never commit a real .env (spec section 49).
APP_ENV=development
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_SECURE=false            # must be true in production (HTTPS)

# Either a full SQLAlchemy URL ...
DATABASE_URL=
# ... or the parts below (DATABASE_URL wins when set)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=carbon_platform
SQL_SERVER_USERNAME=
SQL_SERVER_PASSWORD=
SQL_SERVER_DRIVER=ODBC Driver 17 for SQL Server
SQL_SERVER_TRUSTED_CONNECTION=false    # true = Windows authentication
SQL_SERVER_TRUST_SERVER_CERTIFICATE=true

CORS_ORIGINS=http://localhost:4200

# Field-level encryption key for bank account numbers (Fernet). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_PREVIOUS_KEYS=         # rotation only: old Fernet keys, comma separated (then: manage.py rotate-data-key)
# JWT signing-key rotation: tokens carry kid=JWT_KEY_ID; old keys verify during the window as "kid:secret,kid:secret"
JWT_KEY_ID=k1
JWT_PREVIOUS_KEYS=
# Production: secrets are files mounted by the self-hosted secret store (one file per setting); .env is not read in production
SECRETS_DIR=

# Documents (Phase 12B, docs/storage-and-scanning.md). local = development / test only (refused in production);
# s3 = MinIO through the S3 API: one private, versioned bucket per environment named <prefix>-live / <prefix>-demo,
# SSE-S3 required on every object. Production needs an https:// endpoint.
STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=                    # default: <repo>/storage/local-dev
MAX_UPLOAD_BYTES=15728640
OBJECT_STORAGE_ENDPOINT=               # e.g. https://minio.internal:9000
OBJECT_STORAGE_REGION=us-east-1        # SigV4 signing region (MinIO default)
OBJECT_STORAGE_BUCKET_PREFIX=carbon
OBJECT_STORAGE_ACCESS_KEY=             # application identity: get / put / list only (NO delete)
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_DELETE_ACCESS_KEY=      # separate deletion identity for the orphan-cleanup job; empty = deletion disabled
OBJECT_STORAGE_DELETE_SECRET_KEY=
OBJECT_STORAGE_CA_CERT=                # optional CA bundle path for a private-CA MinIO certificate
OBJECT_STORAGE_TIMEOUT_SECONDS=30
# Antivirus. signature = EICAR test-signature check only (development / TEST / DEMO; results are NOT_SCANNED, never CLEAN).
# Production requires the commercial scanner adapter registered under MALWARE_SCANNER (no vendor selected yet: deployment item).
MALWARE_SCANNER=signature
ANTIVIRUS_ENDPOINT=
ANTIVIRUS_API_KEY=
ANTIVIRUS_TIMEOUT_SECONDS=30

# Basemap tiles (decision D6). Defaults to OpenStreetMap's public server: development only.
# Production: a licensed or self-hosted tile service, e.g. MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
MAP_TILE_PROVIDER=osm-dev
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
MAP_TILE_MAX_ZOOM=19
MAP_TILE_SUBDOMAINS=
# 3D map view terrain (elevation) tiles - display only. Default: public AWS Terrain Tiles (development only).
# Production: a licensed or self-hosted DEM tile source. Empty MAP_TERRAIN_URL = 3D view without relief.
MAP_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
# terrarium | mapbox
MAP_TERRAIN_ENCODING=terrarium
MAP_TERRAIN_MAX_ZOOM=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=600
MAX_REQUEST_BYTES=26214400             # enforced on the streamed body (chunked included)
# Phase 12B D19 (locked values, per minute)
REFRESH_RATE_LIMIT_PER_MINUTE=100      # per IP
UPLOAD_RATE_LIMIT_PER_MINUTE=100       # per user
USER_RATE_LIMIT_PER_MINUTE=1000        # per user
ORGANIZATION_RATE_LIMIT_PER_MINUTE=5000
API_BURST_RATE_LIMIT_PER_MINUTE=10000  # whole deployment
# D18 / D20: memory (one process; development) | redis (shared; required in production). Redis outage = fail open (logged + metric)
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_URL=                  # default REDIS_URL; production: rediss://<acl-user>:<password>@host:6380/1
# D21: reverse proxies whose X-Forwarded-For is trusted (IPs / CIDRs, comma separated). Empty = header ignored.
TRUSTED_PROXIES=
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Seeding (manage.py only)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=              # >= 12 chars, letters + digits; must be changed at first sign-in
DEMO_USER_PASSWORD=                    # shared password for DEMO accounts (<role>@demo.carbon.example)

# Phase 12A background jobs. REDIS_URL is the Celery broker only (transport); SQL Server keeps every job and attempt.
# Empty = no broker: jobs stay QUEUED (recorded, recoverable) and lazy expiry keeps every workflow correct.
# Use a password and TLS outside localhost, e.g. rediss://:<password>@redis.internal:6380/0
REDIS_URL=
REDIS_CA_CERT=                         # CA bundle for a private-CA rediss:// endpoint
JOB_ENVIRONMENTS=LIVE,DEMO             # data environments scheduled jobs run for (production: LIVE)
JOB_MAX_RETRIES=3                      # transient failures only; business errors fail at once
JOB_RETRY_BACKOFF_SECONDS=60           # deterministic exponential backoff base (60, 120, 240 … capped at 1 h)
JOB_STALE_AFTER_SECONDS=1800           # lease; must exceed every task time limit
JOB_BATCH_SIZE=200
JOB_EXPIRY_INTERVAL=600                # reservation / order / listing expiry sweeps
JOB_ORPHAN_SCAN_INTERVAL=86400        # orphan-object cleanup (deletes only with the deletion identity configured)
JOB_ORPHAN_GRACE_HOURS=24
JOB_RESCAN_INTERVAL=86400              # background antivirus rescan of documents without a CLEAN scan
JOB_RETENTION_INTERVAL=86400           # retention purge infrastructure: no retention policy exists, nothing is purged
JOB_RECOVERY_INTERVAL=60
JOB_HEARTBEAT_SECONDS=30

# docker-compose only: MinIO administrator (used by the one-shot minio-init service, never by the application) and the
# development SSE-S3 master key (MinIO KMS single-key mode; production uses a managed KES / KMS - see the runbook)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_KMS_SECRET_KEY=                  # format: <key-name>:<base64 of 32 random bytes>

# Later phases
# D38: runtime providers are manual; production refuses mock / fake / test / stub / demo provider names
SATELLITE_PROVIDER=manual
LAB_PROVIDER=manual
REGISTRY_PROVIDER=manual
PAYMENT_PROVIDER=manual

# Phase 12B D44 / D43: structured logs (json in production) and platform-neutral metrics (GET /metrics, bearer token; unset = disabled)
LOG_FORMAT=json
LOG_LEVEL=INFO
METRICS_TOKEN=
# Phase 12B D39 / D41: SMTP is the selected future channel; external delivery is DEFERRED (only "disabled" is accepted)
NOTIFICATION_EXTERNAL_DELIVERY=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Phase 12B-III operations (docs/operations-runbook.md)
OPERATIONAL_RETENTION_DAYS=60          # D48: access logs, read notifications, worker heartbeats (production: >= 60)
DISK_WARN_FREE_MB=2048                 # readiness degraded below this
DISK_CRITICAL_FREE_MB=1024             # readiness fails, uploads / local backups / drills refused below this
BACKUP_URL=                            # production: s3://<backup-endpoint>/<object-locked-bucket>/carbon (BACKUP TO URL)
BACKUP_ENCRYPTION_CERT=                # production: name of the backup server certificate in master
